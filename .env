# Demo environment: no backend. API calls are answered in the browser by demo/server,
# so this host is never contacted. It is deliberately not a real address.
NEXT_PUBLIC_API_URL=https://api.demo.invalid
NEXT_PUBLIC_WS_URL=wss://api.demo.invalid
NEXT_PUBLIC_APP_ENV=demo

# Platform connector catalog ids (demo/data/platform.ts CONNECTOR_CATALOG).
NEXT_PUBLIC_BIG_QUERY_CONNECTOR_ID=c0000000-0000-4000-8000-000000000001
NEXT_PUBLIC_NET_SUITE_CONNECTOR_ID=c0000000-0000-4000-8000-000000000002
NEXT_PUBLIC_AIRTABLE_CONNECTOR_ID=c0000000-0000-4000-8000-000000000003
NEXT_PUBLIC_NOTION_CONNECTOR_ID=c0000000-0000-4000-8000-000000000004
NEXT_PUBLIC_GOOGLE_DRIVE_CONNECTOR_ID=c0000000-0000-4000-8000-000000000005
